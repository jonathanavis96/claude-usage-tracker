[Unit]
Description=Sample Dave's Claude usage meter into its own log (claude-usage-tracker passive join)
# Each watched account needs its own reset-bearing log. The sampler refuses
# (exit 2) to append to a log that holds another account.
# Since 2026-10-12 Dave's seat has only a `claude setup-token` token, which the
# usage endpoint refuses: --token-env reads the meters off the rate-limit
# headers of a 1-token Haiku call, at most every 5 minutes, with the token
# taken from ~/.config/greenscape/env (never ~/.claude-dave/.credentials.json).

[Service]
Type=oneshot
WorkingDirectory=%h/claude-usage-tracker
ExecStart=/usr/bin/python3 -m tracker.meter_log --config-dir %h/.claude-dave --account dave --log %h/.paperclip/ops/claude-usage-meter-dave.log --token-env GS_DAVE_CLAUDE_OAUTH_TOKEN
# Exit 4 means the usage read failed and was logged as a gap; the next tick tries again.
SuccessExitStatus=0 4
Nice=10
