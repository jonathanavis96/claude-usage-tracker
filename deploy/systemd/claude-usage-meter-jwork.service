[Unit]
Description=Sample Jwork's Claude usage meter into its own log (claude-usage-tracker passive join)
# Each watched account needs its own reset-bearing log. The sampler refuses
# (exit 2) to append to a log that holds another account.

[Service]
Type=oneshot
WorkingDirectory=%h/claude-usage-tracker
ExecStart=/usr/bin/python3 -m tracker.meter_log --config-dir %h/.claude-javiswork --account jwork --log %h/.paperclip/ops/claude-usage-meter-jwork.log
# Exit 4 means the usage read failed and was logged as a gap; the next tick tries again.
SuccessExitStatus=0 4
Nice=10
